# ---------------------------------------------------------------
# Zlaqa Team OS environment
# Copy to .env.local and fill in.
# ---------------------------------------------------------------

# "demo"     -> runs fully in the browser (localStorage), demo logins, no backend
# "supabase" -> real backend (Postgres + Auth + Storage + Realtime)
NEXT_PUBLIC_DATA_MODE=demo

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never expose to the browser. Used by /api/admin/users and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Show one-click demo login buttons on the login page (turn off in production)
NEXT_PUBLIC_SHOW_DEMO_LOGINS=true
